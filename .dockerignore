# ── Secrets — NEVER bake these into the image ─────────────────────────────────
.env
*.env
.env.*
!.env.example

# ── Python artifacts ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Version control ───────────────────────────────────────────────────────────
.git/
.gitignore

# ── Dev tooling ───────────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# ── Node / frontend (not needed in backend image) ─────────────────────────────
node_modules/
dist/
.vite/

# ── OS noise ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
