# =============================================================================
# frontend/Dockerfile.prod — Multi-stage production build for the React SPA
# =============================================================================
#
# Stage 1 (builder): Node 20 Alpine — installs deps and runs `vite build`
# Stage 2 (runtime): Nginx Alpine   — serves the static dist/ with SPA routing
#
# WHY multi-stage?
#   The builder image contains ~500 MB of node_modules and build tooling.
#   The runtime image only needs the compiled ~2 MB dist/ directory.
#   Multi-stage build = ~15 MB final image vs ~520 MB single-stage.
#
# VITE ENV VARS
#   VITE_* variables are baked into the JavaScript bundle at build time.
#   They are NOT available at runtime (unlike backend env vars).
#   Pass them as --build-arg in docker compose or docker build.
#
# USAGE (via docker-compose.prod.yml — don't build manually):
#   docker compose -f docker-compose.prod.yml build frontend
# =============================================================================

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files first — Docker layer cache means `npm ci` only re-runs
# when package-lock.json changes, not on every source file edit.
COPY package.json package-lock.json ./
RUN npm ci --frozen-lockfile

# Copy source
COPY . .

# Vite injects VITE_* env vars at build time via import.meta.env.
# Pass them as build args from docker-compose.prod.yml → ARG → ENV.
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

# TypeScript check + Vite bundle
RUN npm run build

# ── Stage 2: Serve ────────────────────────────────────────────────────────────
FROM nginx:stable-alpine AS runtime

# SPA routing: every 404 falls back to index.html so React Router works.
# The outer nginx (nginx.prod.conf) handles SSL; this inner nginx is HTTP-only.
RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    # SPA fallback — React Router handles the routing client-side\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
\n\
    # Long-lived cache for hashed assets (Vite adds content hashes to filenames)\n\
    location ~* \\.(js|css|woff2?|png|jpg|webp|svg|ico|webm)$ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, max-age=31536000, immutable";\n\
    }\n\
\n\
    # Disable nginx version in error pages\n\
    server_tokens off;\n\
}\n' > /etc/nginx/conf.d/default.conf

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Healthcheck — Docker / Pi systemd can restart the container if it goes dark
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:80/ | grep -q "JobifAI" || exit 1

EXPOSE 80

# Non-root user for security (nginx master still needs root to bind port 80,
# but worker processes drop to nginx user automatically)
