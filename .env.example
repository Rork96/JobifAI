# ──────────────────────────────────────────────────────────────────────────────
# JobifAI — Environment Variable Template
# ──────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in real values in .env
#   3. NEVER commit .env to git — it's in .gitignore
#
# This file (.env.example) IS committed so new team members know what secrets
# are required without having to ask.  Values here are obviously fake.
# ──────────────────────────────────────────────────────────────────────────────


# ── Runtime Environment ────────────────────────────────────────────────────────
# Controls: /docs visibility, extra CORS origins, log verbosity.
# Values: "dev" | "prod"
ENVIRONMENT=dev


# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Your project's REST endpoint (public, safe to expose in the frontend too)
SUPABASE_URL=https://cogkuuebflspsiqtjhli.supabase.co

# SERVICE ROLE key — has admin privileges, bypasses Row Level Security.
# ⚠️  NEVER send this to the browser / frontend.  Backend use only.
SUPABASE_KEY=sb_publishable_BiUDlf2CDTw4Ln9XYt3AFw_UHPiBRIJ

# JWT signing secret — used to validate user access tokens locally (HS256).
# Eliminates the network round-trip to Supabase Auth on every authenticated request.
# Found in: Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
# ⚠️  Keep this secret — possession of this value can forge valid-looking JWTs.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ANON key — safe for the frontend (Vite will expose it via VITE_ prefix).
# Separate from SUPABASE_KEY so we don't accidentally use the service role client-side.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNvZ2t1dWViZmxzcHNpcXRqaGxpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzM5NTY2MDgsImV4cCI6MjA4OTUzMjYwOH0.Pc65heIcsZhzUCersY9lWZPTBZxdTYMO6o0py4itEIE


# ── Google Gemini ─────────────────────────────────────────────────────────────
# Found in: https://aistudio.google.com/app/apikey
# This is OUR key for the hosted free tier.
# Users can supply their own key as a BYOK easter egg (handled per-request).
GEMINI_API_KEY=AIzaSy_example_gemini_key_here


# ── Stripe ────────────────────────────────────────────────────────────────────
# Found in: https://dashboard.stripe.com/apikeys
# Use sk_test_... for development, sk_live_... for production.
STRIPE_SECRET_KEY=sk_test_example_stripe_secret_key_here

# Webhook signing secret — verifies Stripe events aren't forged.
# Found in: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
# ⚠️  This value is consumed by the stripe-webhook Edge Function, NOT the FastAPI backend.
# Set it as a Supabase secret:  supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_SECRET=whsec_example_webhook_signing_secret_here


# ── Supabase Edge Function secrets ────────────────────────────────────────────
# These are NOT .env file values — they are set via the Supabase CLI.
# Kept here for documentation only so you know what to set.
#
# supabase secrets set STRIPE_SECRET_KEY=sk_test_...
# supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
# supabase secrets set SUPABASE_SERVICE_ROLE_KEY=<your service role key>
#
# SUPABASE_SERVICE_ROLE_KEY is required by the stripe-webhook Edge Function.
# It is the same key as SUPABASE_KEY above — the service role key.
# SUPABASE_URL and SUPABASE_ANON_KEY are injected automatically by the Edge runtime.
# ⚠️  NEVER expose SUPABASE_SERVICE_ROLE_KEY to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here


# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Variables prefixed with VITE_ are automatically exposed to the React app.
# ⚠️  Only put PUBLIC, non-secret values here.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key_here
VITE_API_BASE_URL=http://localhost:8000

# Stripe Price IDs — safe to expose (they are public identifiers, not secrets).
# Found in: Stripe Dashboard → Products → [product] → Pricing → Price ID
# Format: price_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_STRIPE_24H_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx
