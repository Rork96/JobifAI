# ──────────────────────────────────────────────────────────────────────────────
# JobifAI — Environment Variable Template
# ──────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in real values in .env
#   3. NEVER commit .env to git — it's in .gitignore
#
# This file (.env.example) IS committed so new team members know what secrets
# are required without having to ask.  Values here are obviously fake.
# ──────────────────────────────────────────────────────────────────────────────


# ── Runtime Environment ────────────────────────────────────────────────────────
# Controls: /docs visibility, extra CORS origins, log verbosity.
# Values: "dev" | "prod"
ENVIRONMENT=dev


# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Your project's REST endpoint (public, safe to expose in the frontend too)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# SERVICE ROLE key — has admin privileges, bypasses Row Level Security.
# ⚠️  NEVER send this to the browser / frontend.  Backend use only.
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key_here

# ANON key — safe for the frontend (Vite will expose it via VITE_ prefix).
# Separate from SUPABASE_KEY so we don't accidentally use the service role client-side.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key_here


# ── Google Gemini ─────────────────────────────────────────────────────────────
# Found in: https://aistudio.google.com/app/apikey
# This is OUR key for the hosted free tier.
# Users can supply their own key as a BYOK easter egg (handled per-request).
GEMINI_API_KEY=AIzaSy_example_gemini_key_here


# ── Stripe ────────────────────────────────────────────────────────────────────
# Found in: https://dashboard.stripe.com/apikeys
# Use sk_test_... for development, sk_live_... for production.
STRIPE_SECRET_KEY=sk_test_example_stripe_secret_key_here

# Webhook signing secret — verifies Stripe events aren't forged.
# Found in: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_example_webhook_signing_secret_here


# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Variables prefixed with VITE_ are automatically exposed to the React app.
# ⚠️  Only put PUBLIC, non-secret values here.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key_here
VITE_API_BASE_URL=http://localhost:8000
